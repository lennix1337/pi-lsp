{
  "name": "@lennix1337/pi-lsp",
  "version": "0.1.0",
  "private": true,
  "description": "Compiler-backed code navigation for Pi: references, definition, scope-aware rename, hover and diagnostics from the project's language server (TypeScript/JavaScript, C#).",
  "author": "lennix1337",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "lsp",
    "rename",
    "references"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "mutations": "node test/mutations.mjs",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "typescript-language-server": "^5.1.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript5": "npm:typescript@^5.9.3"
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lennix1337/pi-lsp.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
